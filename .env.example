POSTGRES_USER=ffcl
POSTGRES_PASSWORD=ffcl
POSTGRES_DB=ffcl
DATABASE_URL=postgresql+asyncpg://ffcl:ffcl@postgres:5432/ffcl
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-dev-secret-at-least-32-bytes-long
NEXT_PUBLIC_API_URL=http://localhost:8000
# development | production. Production refuses the default JWT secret and requires rate limits.
ENVIRONMENT=development
# Throttles login, registration and OTP requests. Keep true in production; dev/e2e runs register many users from one machine.
AUTH_RATE_LIMITS_ENABLED=true
# Public address of the website (used in sitemap, share cards and search results)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Browser push (optional). Generate keys with:  cd api && uv run python -m app.make_vapid
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example
# PUSH_DRY_RUN=true logs pushes instead of sending them (staging and browser tests)
